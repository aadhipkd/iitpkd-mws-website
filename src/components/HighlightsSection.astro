---
import type { HighlightItem } from "../lib/highlights";

interface Props {
  data?: {
    label: string;
    title: string;
    subtitle: string;
  };
  items?: HighlightItem[];
}

const { data, items = [] } = Astro.props;

const label = data?.label ?? "Featured";
const title = data?.title ?? "Highlights";
const subtitle = data?.subtitle ?? "";
const highlights = items.slice(0, 3);

const isExternal = (url: string) => !url.startsWith("/");
---

<section id="highlights" class="section" aria-labelledby="highlights-heading">
  <div class="container">
    <div class="reveal">
      <span class="section-label">{label}</span>
      <h2 id="highlights-heading" class="section-title">{title}</h2>
      <p class="section-subtitle">
        {subtitle}
      </p>
    </div>

    <div class="highlights-grid">
      {highlights.map((item, i) => (
        <a
          href={item.url}
          class="highlight-card reveal"
          style={`--reveal-delay: ${Math.min(i, 5) * 70}ms`}
          target={isExternal(item.url) ? "_blank" : undefined}
          rel={isExternal(item.url) ? "noopener noreferrer" : undefined}
        >
          {item.image ? (
            <img src={item.image} alt={item.title} class="highlight-image" loading="lazy" />
          ) : (
            <div class="highlight-placeholder" aria-hidden="true">
              <span class="placeholder-text">[ Image ]</span>
            </div>
          )}
          <div class="highlight-body">
            <h3 class="highlight-title">{item.title}</h3>
            {item.description && (
              <p class="highlight-desc">{item.description}</p>
            )}
            <span class="highlight-link">
              Read more <span aria-hidden="true">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .highlight-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    transition: box-shadow var(--transition-base), border-color var(--transition-base),
      transform var(--transition-base);
  }

  @media (prefers-reduced-motion: no-preference) {
    .highlight-card:hover {
      border-color: var(--color-accent);
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight-card:hover {
      border-color: var(--color-accent);
      box-shadow: var(--shadow-md);
    }
  }

  @media (hover: hover) {
    .highlight-card:hover .highlight-image {
      transform: scale(1.03);
    }
  }

  .highlight-image {
    transition: transform var(--transition-base);
  }

  .highlight-placeholder {
    width: 100%;
    height: 180px;
    background-color: var(--color-bg-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border-light);
  }

  .highlight-image {
    width: 100%;
    height: 180px;
    object-fit: contain;
    background-color: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border-light);
  }

  .placeholder-text {
    font-size: var(--text-sm);
    color: var(--color-border);
    letter-spacing: 0.04em;
  }

  .highlight-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .highlight-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .highlight-desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin-bottom: var(--space-4);
  }

  .highlight-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    transition: gap var(--transition-fast), color var(--transition-fast);
  }

  .highlight-card:hover .highlight-link {
    color: var(--color-primary);
    gap: var(--space-3);
  }

  @media (min-width: 769px) {
    .highlights-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
