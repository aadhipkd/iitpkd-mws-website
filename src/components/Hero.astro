---
interface Props {
  data?: {
    label: string;
    title: string;
    primaryCta: { label: string; href: string };
    secondaryCta: { label: string; href: string };
    image?: string;
  };
}

import { withBase } from "../lib/base";

const { data } = Astro.props;

const label = data?.label ?? "";
const title = data?.title ?? "";
const primaryCta = data?.primaryCta ?? { label: "Explore Services", href: "/services" };
const secondaryCta = data?.secondaryCta ?? { label: "Contact Us", href: "/contact" };
const heroImage = data?.image;
---

<section class="hero" aria-label="Hero">
  <div class="hero-bg" aria-hidden="true">
    {heroImage ? (
      <img src={withBase(heroImage)} alt="" class="hero-image" />
    ) : (
      <div class="hero-placeholder" aria-hidden="true"></div>
    )}
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content container">
    <p class="hero-label">{label}</p>
    <h1 class="hero-title">{title}</h1>
    <div class="hero-actions">
      <a href={withBase(primaryCta.href)} class="btn btn--primary">{primaryCta.label}</a>
      <a href={withBase(secondaryCta.href)} class="btn btn--outline">{secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 520px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-primary-dark);
    background-image: radial-gradient(
      60% 80% at 70% 20%,
      rgba(74, 154, 232, 0.18),
      transparent 60%
    );
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      135deg,
      rgba(6, 26, 61, 0.88) 0%,
      rgba(10, 42, 94, 0.82) 50%,
      rgba(27, 77, 143, 0.78) 100%
    );
    background-size: 200% 200%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-overlay {
      animation: heroDrift 16s ease-in-out infinite alternate;
    }

    @keyframes heroDrift {
      from {
        background-position: 0% 40%;
      }
      to {
        background-position: 100% 60%;
      }
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
    color: var(--color-text-inverse);
  }

  .hero-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: clamp(var(--text-2xl), 1.2rem + 2.5vw, var(--text-3xl));
    font-weight: var(--weight-bold);
    color: var(--color-text-inverse);
    line-height: var(--leading-tight);
    max-width: 720px;
    margin-bottom: var(--space-8);
    white-space: pre-line;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-label,
    .hero-title,
    .hero-actions {
      opacity: 0;
      animation: heroRise 600ms ease forwards;
    }

    .hero-label {
      animation-delay: 100ms;
    }

    .hero-title {
      animation-delay: 200ms;
    }

    .hero-actions {
      animation-delay: 300ms;
    }

    @keyframes heroRise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-label,
    .hero-title,
    .hero-actions {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 400px;
    }

    .hero-content {
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }
  }
</style>
