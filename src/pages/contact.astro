---
import { getEntry } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/base";

const page = await getEntry("pages", "contact");
const data = page?.data;
const blocks = data?.blocks ?? [];
const contactBlocks = blocks.filter((b) => b.type === "contact");
const noteBlock = blocks.find((b) => b.type === "paragraph");
const headingBlock = blocks.find((b) => b.type === "heading");
const portalButton = blocks.find((b) => b.type === "button");
---

<MainLayout title={data?.pageTitle}>
  <Header />
  <main>
    <PageHeader title={data?.headerTitle} subtitle={data?.headerSubtitle} />

    <section class="section" aria-labelledby="contact-info">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-details">
            <h2 id="contact-info" class="content-heading">{headingBlock?.title ?? "Get in Touch"}</h2>

            <div class="contact-items">
              {contactBlocks.map((item) => (
                <div class="contact-item">
                  <span class="contact-item-label">{item.label}</span>
                  {item.links?.[0] ? (
                    <a href={withBase(item.links[0].href)} class="contact-item-value contact-item-link">
                      {item.value}
                    </a>
                  ) : (
                    <span class="contact-item-value">{item.value}</span>
                  )}
                </div>
              ))}
            </div>

            {noteBlock?.text && (
              <div class="contact-note">
                <p>{noteBlock.text}</p>
              </div>
            )}
          </div>

          <div class="portal-card">
            <h3 class="portal-heading">{portalButton?.label ?? "Request a Service"}</h3>
            <p class="portal-text">
              For website, media or AV service requests, please use the
              institute support portal.
            </p>
            <a
              class="btn btn--accent"
              style="width: 100%;"
              href={withBase(portalButton?.links?.[0]?.href ?? "#")}
              target="_blank"
              rel="noopener"
            >
              {portalButton?.links?.[0]?.label ?? "Open Support Portal"} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</MainLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  .content-heading {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    margin-bottom: var(--space-6);
  }

  .contact-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .contact-item-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .contact-item-value {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-item-link:hover {
    color: var(--color-accent);
  }

  .contact-note {
    padding: var(--space-4);
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
  }

  .contact-note p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .portal-card {
    padding: var(--space-8);
    background-color: var(--color-bg-light);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-self: start;
  }

  .portal-heading {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
  }

  .portal-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  @media (min-width: 769px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
</style>
