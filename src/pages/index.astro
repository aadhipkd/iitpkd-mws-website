---
import { getEntry } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import QuickLinks from "../components/QuickLinks.astro";
import AboutSection from "../components/AboutSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import HighlightsSection from "../components/HighlightsSection.astro";
import NewsSection from "../components/NewsSection.astro";
import SupportCTA from "../components/SupportCTA.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import { getNews } from "../lib/news";
import { getHighlights } from "../lib/highlights";
import { withBase } from "../lib/base";

const settings = await getEntry("site-settings", "settings");
const home = await getEntry("home", "home");

const title = settings?.data.siteTitle;
const description = settings?.data.siteDescription;
const ogSiteName = settings?.data.ogSiteName;

const allNews = await getNews();
const allHighlights = await getHighlights();

// Ticker shows the sheet-driven highlights (titles + their own links), not news.
const highlightItems = allHighlights.slice(0, 6);
const tickerEnabled = home?.data.news.tickerEnabled ?? true;
const tickerLabel = home?.data.news.tickerLabel ?? "Highlights";

// Each loop group must be ~2x the viewport width for the seamless -50% slide.
// With few items, repeat them inside the group; estimate ~280px per item.
const tickerReps = Math.max(
  1,
  Math.ceil(2400 / Math.max(highlightItems.length * 280, 1))
);
const tickerLoop = Array.from(
  { length: tickerReps },
  () => highlightItems
).flat();
---

<MainLayout title={title} description={description}>
  <Header />
  <main>
    <Hero data={home?.data.hero} />
    {tickerEnabled && tickerLoop.length > 0 && (
      <div class="ticker" aria-label="Highlights">
        <div class="container ticker-inner">
          <span class="ticker-label">{tickerLabel}</span>
          <div class="ticker-viewport">
            <div class="ticker-track">
              {[0, 1].map((copy) => (
                <div class="ticker-group" aria-hidden={copy === 1 ? "true" : undefined}>
                  {tickerLoop.map((item, i) => (
                    <a
                      href={item.url ? withBase(item.url) : withBase("/")}
                      class="ticker-item"
                      tabindex={copy === 1 || i >= highlightItems.length ? -1 : undefined}
                    >
                      <span aria-hidden="true" class="ticker-dot">•</span>
                      {item.title}
                    </a>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    )}
    <QuickLinks data={home?.data.quickLinks} />
    <AboutSection data={home?.data.about} />
    <ServicesSection data={home?.data.services} />
    <HighlightsSection data={home?.data.highlights} items={allHighlights} />
    <NewsSection data={home?.data.news} items={allNews} />
    <SupportCTA data={home?.data.supportCta} />
    <ContactSection data={home?.data.contact} />
  </main>
  <Footer />
</MainLayout>

<style>
  .ticker {
    background-color: var(--color-primary-dark);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ticker-inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
    min-height: 44px;
  }

  .ticker-label {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-inverse);
    background-color: var(--color-accent);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .ticker-viewport {
    flex: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 13%, black 87%, transparent);
    mask-image: linear-gradient(to right, transparent, black 13%, black 87%, transparent);
    contain: layout paint;
  }

  .ticker-track {
    display: flex;
    align-items: center;
    width: max-content;
    will-change: transform;
    backface-visibility: hidden;
  }

  .ticker-group {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-2);
    margin-right: var(--space-8);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
  }

  .ticker-item:hover {
    color: var(--color-text-inverse);
  }

  .ticker-dot {
    color: var(--color-accent-light);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      animation: tickerScroll 60s linear infinite;
    }

    .ticker:hover .ticker-track,
    .ticker:focus-within .ticker-track {
      animation-play-state: paused;
    }

    @keyframes tickerScroll {
      from {
        transform: translate3d(0, 0, 0);
      }
      to {
        transform: translate3d(-50%, 0, 0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-viewport {
      overflow-x: auto;
    }

    .ticker-track {
      animation: none;
    }
  }
</style>
